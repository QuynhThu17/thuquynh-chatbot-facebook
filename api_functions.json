{
  "project_info": {
    "name": "MekongAI Social Media Bot System",
    "version": "1.0.0",
    "description": "Hệ thống quản lý Social Media Bot toàn diện với CRM, Knowledge Management và nhiều tính năng khác",
    "company": "MekongAI",
    "api_base_url": "/api/v1",
    "super_admin_api": "/mekongai-internal-api"
  },
  "system_architecture": {
    "description": "Hệ thống được thiết kế theo kiến trúc hierarchy với khả năng White Label",
    "hierarchy_levels": [
      {
        "level": 0,
        "role": "SuperAdmin (MekongAI)",
        "permissions": "Toàn quyền kiểm soát hệ thống",
        "description": "Quản lý White Label partners, system monitoring"
      },
      {
        "level": 1,
        "role": "White Label Admin",
        "permissions": "Toàn quyền trong hệ thống con",
        "description": "Tự quản lý branding, tạo partners và users"
      },
      {
        "level": 2,
        "role": "Partner Admin (Reseller)",
        "permissions": "Quản lý customers và bán packages",
        "description": "Tạo end-users, bán packages, theo dõi commission"
      },
      {
        "level": 3,
        "role": "System Admin",
        "permissions": "Admin trong tổ chức",
        "description": "Quản lý users và settings trong tổ chức"
      },
      {
        "level": 4,
        "role": "End Users",
        "permissions": "Dựa theo gói đã mua",
        "description": "Sử dụng bot, CRM theo giới hạn gói"
      }
    ]
  },
  "main_features": {
    "1_user_management": {
      "name": "Quản lý Người dùng & Phân quyền",
      "description": "Hệ thống quản lý người dùng với phân quyền đa cấp và hierarchy",
      "api_prefix": "/users",
      "customer_workflow": {
        "step_1": "Đăng ký tài khoản qua email/password hoặc Google OAuth",
        "step_2": "Thiết lập profile và upload avatar",
        "step_3": "Chọn gói dịch vụ phù hợp",
        "step_4": "Quản lý thông tin cá nhân và settings"
      },
      "sub_features": {
        "user_registration": {
          "name": "Đăng ký & Xác thực",
          "description": "Tạo tài khoản mới với nhiều phương thức",
          "apis": [
            {
              "method": "POST",
              "endpoint": "/users",
              "description": "Tạo user mới",
              "params": ["name", "email", "password", "method"]
            }
          ]
        },
        "user_profile": {
          "name": "Quản lý Profile",
          "description": "Cập nhật thông tin cá nhân và avatar",
          "apis": [
            {
              "method": "GET",
              "endpoint": "/users/{user_id}",
              "description": "Lấy thông tin user"
            },
            {
              "method": "PUT",
              "endpoint": "/users/{user_id}",
              "description": "Cập nhật thông tin user"
            }
          ]
        },
        "hierarchy_management": {
          "name": "Quản lý Cấp bậc",
          "description": "Tạo và quản lý mối quan hệ parent-children",
          "apis": [
            {
              "method": "POST",
              "endpoint": "/hierarchy",
              "description": "Tạo hierarchy mới"
            },
            {
              "method": "GET",
              "endpoint": "/hierarchy/{user_id}",
              "description": "Lấy thông tin hierarchy"
            }
          ]
        },
        "features_roles": {
          "name": "Quản lý Tính năng & Vai trò",
          "description": "Định nghĩa features và roles trong hệ thống",
          "apis": [
            {
              "method": "POST",
              "endpoint": "/features",
              "description": "Tạo feature mới"
            },
            {
              "method": "GET",
              "endpoint": "/features",
              "description": "Lấy danh sách features"
            },
            {
              "method": "POST",
              "endpoint": "/roles",
              "description": "Tạo role mới"
            },
            {
              "method": "GET",
              "endpoint": "/roles",
              "description": "Lấy danh sách roles"
            }
          ]
        },
        "balance_management": {
          "name": "Quản lý Số dư",
          "description": "Theo dõi và quản lý số dư tài khoản",
          "apis": [
            {
              "method": "GET",
              "endpoint": "/users/{user_id}/balance",
              "description": "Lấy balance của user"
            },
            {
              "method": "POST",
              "endpoint": "/users/{user_id}/balance/add",
              "description": "Thêm balance cho user"
            }
          ]
        },
        "packages_subscriptions": {
          "name": "Quản lý Gói & Đăng ký",
          "description": "Tạo gói dịch vụ và quản lý đăng ký",
          "apis": [
            {
              "method": "POST",
              "endpoint": "/packages",
              "description": "Tạo package mới"
            },
            {
              "method": "GET",
              "endpoint": "/packages",
              "description": "Lấy danh sách packages"
            },
            {
              "method": "POST",
              "endpoint": "/subscriptions",
              "description": "Tạo subscription mới"
            },
            {
              "method": "GET",
              "endpoint": "/users/{user_id}/subscriptions",
              "description": "Lấy subscriptions của user"
            }
          ]
        },
        "transactions": {
          "name": "Quản lý Giao dịch",
          "description": "Theo dõi lịch sử giao dịch và thanh toán",
          "apis": [
            {
              "method": "POST",
              "endpoint": "/transactions",
              "description": "Tạo transaction mới"
            },
            {
              "method": "GET",
              "endpoint": "/users/{user_id}/transactions",
              "description": "Lấy transactions của user"
            }
          ]
        }
      }
