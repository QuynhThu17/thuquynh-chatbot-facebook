  "detailed_workflows": {
    "complete_customer_journey": {
      "phase_1_onboarding": {
        "name": "Đăng ký và Khởi tạo",
        "steps": [
          {
            "step": 1,
            "action": "Khách hàng truy cập website và chọn 'Đăng ký'",
            "frontend": "Registration form với options Email/Password hoặc Google",
            "api_call": "POST /api/v1/users",
            "data_required": ["name", "email", "password", "method"]
          },
          {
            "step": 2,
            "action": "Thiết lập profile và upload avatar",
            "frontend": "Profile setup page với drag-drop avatar upload",
            "api_call": "PUT /api/v1/users/{user_id}",
            "data_required": ["avatar_url", "additional_info"]
          },
          {
            "step": 3,
            "action": "Chọn gói dịch vụ",
            "frontend": "Pricing page với feature comparison",
            "api_call": "POST /api/v1/subscriptions",
            "data_required": ["package_id", "payment_method"]
          }
        ]
      },
      "phase_2_setup": {
        "name": "Thiết lập Cơ bản",
        "steps": [
          {
            "step": 1,
            "action": "Tạo Company profile",
            "frontend": "Company setup wizard",
            "api_call": "POST /api/v1/crm/companies",
            "data_required": ["name", "industry", "address", "website"]
          },
          {
            "step": 2,
            "action": "Kết nối Social Media accounts",
            "frontend": "Social platforms grid với OAuth buttons",
            "api_call": "POST /api/v1/social-accounts",
            "data_required": ["social_id", "access_token"]
          },
          {
            "step": 3,
            "action": "Upload tài liệu công ty",
            "frontend": "Document upload với preview",
            "api_call": "POST /api/v1/knowledge/documents/upload",
            "data_required": ["file", "title", "category"]
          }
        ]
      },
      "phase_3_bot_creation": {
        "name": "Tạo Bot",
        "steps": [
          {
            "step": 1,
            "action": "Vào 'Quản lý Bot' và nhấn 'Tạo Bot Mới'",
            "frontend": "Bot creation wizard với progress indicator",
            "api_call": "Chuẩn bị form creation",
            "data_required": []
          },
          {
            "step": 2,
            "action": "Chọn/tạo Identity",
            "frontend": "Identity selection với preview examples",
            "api_call": "POST /api/v1/identities (nếu tạo mới)",
            "data_required": ["name", "style", "conversation_example"]
          },
          {
            "step": 3,
            "action": "Chọn/tạo Procedure",
            "frontend": "Workflow builder với drag-drop nodes",
            "api_call": "POST /api/v1/procedures (nếu tạo mới)",
            "data_required": ["name", "procedure_steps"]
          },
          {
            "step": 4,
            "action": "Cấu hình Bot",
            "frontend": "Bot configuration form",
            "api_call": "POST /api/v1/bots",
            "data_required": [
              "name",
              "identity_id",
              "procedure_id",
              "role",
              "target"
            ]
          },
          {
            "step": 5,
            "action": "Kết nối với Social platforms",
            "frontend": "Platform selection modal",
            "api_call": "PUT /api/v1/bots/{bot_id}",
            "data_required": ["connect"]
          }
        ]
      },
      "phase_4_crm_setup": {
        "name": "Thiết lập CRM",
        "steps": [
          {
            "step": 1,
            "action": "Import/thêm Contacts",
            "frontend": "Contact management với import options",
            "api_call": "POST /api/v1/crm/contacts hoặc POST /api/v1/crm/contacts/import",
            "data_required": ["name", "email", "phone", "type"]
          },
          {
            "step": 2,
            "action": "Tạo Product catalog",
            "frontend": "Product management với image gallery",
            "api_call": "POST /api/v1/crm/products",
            "data_required": ["name", "sku", "pricing", "media"]
          },
          {
            "step": 3,
            "action": "Thiết lập Warehouses",
            "frontend": "Warehouse setup với inventory tracking",
            "api_call": "POST /api/v1/crm/warehouses",
            "data_required": ["name", "address", "inventory"]
          }
        ]
      },
      "phase_5_operations": {
        "name": "Vận hành",
        "steps": [
          {
            "step": 1,
            "action": "Bot nhận tin nhắn và tự động tạo Orders",
            "frontend": "Order dashboard với real-time updates",
            "api_call": "POST /api/v1/crm/orders (auto từ bot)",
            "data_required": ["contact_id", "line_items", "total_price"]
          },
          {
            "step": 2,
            "action": "Xử lý và tạo Shipments",
            "frontend": "Shipment management với tracking",
            "api_call": "POST /api/v1/crm/shipments",
            "data_required": ["order_id", "carrier", "tracking_number"]
          },
          {
            "step": 3,
            "action": "Monitor performance và analytics",
            "frontend": "Dashboard với charts và metrics",
            "api_call": "GET /api/v1/additional/analytics/dashboard",
            "data_required": ["user_id", "date_range"]
          }
        ]
      }
    },
    "bot_interaction_flow": {
      "name": "Luồng Tương tác Bot",
      "description": "Cách bot xử lý tin nhắn từ khách hàng",
      "steps": [
        {
          "step": 1,
          "event": "Khách hàng gửi tin nhắn trên Facebook/Instagram",
          "bot_action": "Nhận webhook từ platform",
          "api_call": "Webhook trigger → RAG system"
        },
        {
          "step": 2,
          "event": "Bot phân tích intent từ tin nhắn",
          "bot_action": "Sử dụng Identity và Procedure để xác định response",
          "api_call": "POST /api/v1/knowledge/answer"
        },
        {
          "step": 3,
          "event": "Tìm kiếm thông tin trong Knowledge base",
          "bot_action": "Semantic search trong documents và product catalog",
          "api_call": "POST /api/v1/knowledge/search"
        },
        {
          "step": 4,
          "event": "Tạo câu trả lời phù hợp",
          "bot_action": "Generate response dựa trên context và personality",
          "api_call": "Kết hợp RAG + Identity style"
        },
        {
          "step": 5,
          "event": "Lưu conversation history",
          "bot_action": "Store để tracking và analytics",
          "api_call": "POST /api/v1/knowledge/histories"
        },
        {
          "step": 6,
          "event": "Nếu cần tạo order",
          "bot_action": "Extract order info và tạo order tự động",
          "api_call": "POST /api/v1/crm/orders"
        }
      ]
    },
    "dashboard_usage_flow": {
      "name": "Luồng Sử dụng Dashboard",
      "description": "Cách khách hàng sử dụng dashboard hàng ngày",
      "daily_tasks": [
        {
          "task": "Kiểm tra tổng quan",
          "action": "Xem dashboard với metrics tổng quan",
          "api_call": "GET /api/v1/additional/analytics/dashboard",
          "metrics": ["bot_messages", "new_orders", "conversion_rate"]
        },
        {
          "task": "Xem orders mới",
          "action": "Check orders từ bot conversations",
          "api_call": "GET /api/v1/crm/orders?status=new",
          "frontend": "Orders table với filtering"
        },
        {
          "task": "Xử lý shipments",
          "action": "Update tracking numbers và status",
          "api_call": "PUT /api/v1/crm/shipments/{id}/status",
          "frontend": "Shipment tracking interface"
        },
        {
          "task": "Review bot performance",
          "action": "Xem conversation histories và feedback",
          "api_call": "GET /api/v1/knowledge/histories",
          "frontend": "Chat logs với filtering options"
        },
        {
          "task": "Manage notifications",
          "action": "Đọc và xử lý notifications",
          "api_call": "GET /api/v1/system/notifications",
          "frontend": "Notification center với categories"
        }
      ]
    }
  },
