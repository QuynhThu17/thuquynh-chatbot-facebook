# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=mekongai_social
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/mekongai_social

# Server Configuration
SERVER_ADDRESS=http://localhost:1945

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SERVER=http://localhost:6333
QDRANT_API_KEY=

# MySQL Configuration
MYSQL_DB_HOST=localhost
MYSQL_DB_NAME=mekongai_social
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=

# VLLM Configuration
VLLM_URL=
VLLM_TOKEN=

# AWS Configuration
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# SuperAdmin & White Label Configuration
# ==========================================
# SuperAdmin Credentials (Chỉ cho MekongAI chính)
SUPERADMIN_EMAIL=admin@mekongai.com
SUPERADMIN_PASSWORD=MekongAI@2025!Secure

# White Label System Configuration
IS_WHITE_LABEL_SYSTEM=false  # true nếu đây là hệ thống White Label của đối tác
WHITE_LABEL_API_KEY=  # API Key của White Label này để gửi dữ liệu về MekongAI
WHITE_LABEL_PARTNER_ID=  # ID của đối tác White Label trong hệ thống MekongAI
WHITE_LABEL_COMPANY_NAME=MekongAI  # Tên công ty hiển thị
WHITE_LABEL_DOMAIN=mekongai.com  # Domain của công ty
MEKONGAI_SUPERADMIN_API_URL=https://api.mekongai.com/super-admin  # URL API MekongAI SuperAdmin

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
